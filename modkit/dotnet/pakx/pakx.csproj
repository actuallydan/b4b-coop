<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- CUE4Parse (Apache-2.0) from NuGet; it brings OodleSharp (MIT, managed Oodle decoder). Nothing proprietary. -->
    <PackageReference Include="CUE4Parse" Version="1.2.2.202609" />
    <!-- CUE4Parse pulls Microsoft.Bcl.Memory 9.0.0 (GHSA-73j8-2gch-69rq); pin the fixed release -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.20" />
  </ItemGroup>
</Project>
